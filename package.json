{
  "name": "turntable",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.12.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  },
  "scripts": {
    "build": "pnpm graphql:check && vite build",
    "danger": "danger ci --failOnErrors",
    "dev": "vite dev --port 3000",
    "format": "biome format . --write",
    "graphql:check": "gql-tada generate-output && gql-tada check",
    "lint": "biome check .",
    "preview": "vite preview",
    "start": "HOST=0.0.0.0 node .output/server/index.mjs",
    "schema:sync": "gql-tada generate-schema https://backboard.railway.com/graphql/v2 --output src/gql/schema.graphql && pnpm graphql:check",
    "skills:list": "intent list",
    "skills:load": "intent load",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "pnpm build && playwright test --config playwright.smoke.config.ts",
    "typecheck": "pnpm graphql:check && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuzzysort": "3.1.0",
    "graphql": "16.14.2",
    "graphql-ws": "6.2.1",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/lint": "21.2.2",
    "@commitlint/load": "21.2.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/intent": "0.3.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "danger": "13.0.10",
    "gql.tada": "1.11.3",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
